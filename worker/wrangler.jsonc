{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "automations",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The dashboard SPA is served from the same Worker as the API, so there is
  // one deploy and no CORS.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },

  // The dispatcher wakes every minute and claims whatever is due. Handlers are
  // expected to be short; anything long-running should chunk itself across runs.
  "triggers": {
    "crons": ["* * * * *"]
  },

  // Structured JSON logs, queryable in the Workers dashboard. Every log line
  // the worker emits goes through src/lib/log.ts so the fields stay consistent.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // In-process open-source model inference. The Free plan hard-stops at its
  // daily allowance, so this does not need a paid provider API key.
  "ai": {
    "binding": "AI",
    "remote": true
  },

  // Each session renders both carousel slides and closes immediately so paid
  // Browser Run time cannot leak through the idle timeout.
  "browser": {
    "binding": "BROWSER"
  },

  // Non-secret config. Secrets are set with `wrangler secret put` -- see README.
  "vars": {
    "SUPABASE_URL": "https://ewmgvujlqvdctzryfbid.supabase.co",
    "PUBLIC_BASE_URL": "https://automations.theojandhyala.workers.dev",
    "TIKTOK_PUBLISH_PROVIDER": "business_accounts",
    "TIKTOK_REVIEW_STATE": "approved",
    "TIKTOK_BUSINESS_CLIENT_ID": "7682672173772718101",
    "TIKTOK_BUSINESS_AUTH_URL": "https://www.tiktok.com/v2/auth/authorize?client_key=7682672173772718101&scope=user.info.basic%2Cuser.info.username%2Cuser.info.stats%2Cuser.info.profile%2Cuser.account.type%2Cuser.insights%2Cvideo.list%2Cvideo.insights%2Ccomment.list%2Ccomment.list.manage%2Cvideo.publish%2Cvideo.upload%2Cbiz.spark.auth%2Cdiscovery.search.words&response_type=code&redirect_uri=https%3A%2F%2Fautomations.theojandhyala.workers.dev%2Fapi%2Ftiktok%2Fcallback%2F",
    "TIKTOK_BUSINESS_REDIRECT_URI": "https://automations.theojandhyala.workers.dev/api/tiktok/callback/",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV3bWd2dWpscXZkY3R6cnlmYmlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgxMTM3ODMsImV4cCI6MjEwMzY4OTc4M30.sQBCfLDKp6u2ER7ANxnt_stCkbx6qXPWt2UcXo0bw_U",
